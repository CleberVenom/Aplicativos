# Copie para ".env" e preencha somente o que for usar. O arquivo .env NÃO vai para o
# Git (está no .gitignore) e só é lido pelo SERVIDOR (rotas /api). As chaves abaixo
# nunca são incluídas no aplicativo instalado no celular.
#
# Passo a passo para conseguir cada chave: docs/configurar-apis.md
#
# Sem nenhuma chave, o app funciona no modo demonstração (claramente identificado).
# Depois de alterar este arquivo, reinicie o servidor (npx expo start).

# --- Análise e propostas (Anthropic / Claude) — necessária para o modo com IA ---
ANTHROPIC_API_KEY=
# Opcional. Padrão: claude-opus-5-5
ANTHROPIC_MODEL=
# Opcional. Esforço de raciocínio: low | medium | high | xhigh | max. Padrão: medium
ANTHROPIC_EFFORT=

# --- Imagens das propostas (escolha UM provedor) ---
# gemini | openai | none. Se ficar vazio, usa o primeiro que tiver chave (Gemini, depois OpenAI).
IMAGE_PROVIDER=

# Google Gemini (Interactions API)
GEMINI_API_KEY=
# Opcional. Padrão: gemini-nano-banana-2.1
GEMINI_IMAGE_MODEL=
# Opcional. 1K | 2K | 4K. Padrão: 1K
GEMINI_IMAGE_SIZE=

# OpenAI (Images API, edição)
OPENAI_API_KEY=
# Opcional. Padrão: gpt-image-2.5-sunburst
OPENAI_IMAGE_MODEL=
# Opcional. low | medium | high. Padrão: medium
OPENAI_IMAGE_QUALITY=

# --- 3D imersivo (World Labs Marble) — opcional, tem custo por geração ---
WORLDLABS_API_KEY=
# Opcional. Padrão: marble-1.1
WORLDLABS_MODEL=
# Opcional. true = quem tiver o link pode abrir o mundo 3D (necessário para abri-lo
# no navegador do celular); false = só a conta dona da chave. Padrão: true
WORLDLABS_LINK_ACCESS=

# --- Proteção do servidor ---
# Opcional. Análises por hora por endereço IP (limite em memória). Padrão: 60
RATE_LIMIT_PER_HOUR=

# --- Variável PÚBLICA do app (vai para dentro do aplicativo; nunca coloque segredos) ---
# Endereço do servidor publicado (ex.: https://seu-app.expo.app). Deixe vazio em
# desenvolvimento: o app usa o próprio servidor do "npx expo start".
EXPO_PUBLIC_API_URL=
