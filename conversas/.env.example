PORT=3000
DATABASE_PATH=data/conversas.db

# Primeiro acesso: administrador criado automaticamente quando o banco está vazio.
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=troque-esta-senha

# WhatsApp Cloud API (Meta for Developers > seu app > WhatsApp > Configuração da API)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Texto livre que você escolhe e repete no campo "Verificar token" do webhook na Meta.
WHATSAPP_VERIFY_TOKEN=
# Configurações do app > Básico > Chave secreta do app (usada para validar os webhooks).
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v23.0
